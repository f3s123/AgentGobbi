APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8000
# Local default: runtime/app.db. Production MUST use certificate-verified PostgreSQL.
# DATABASE_URL=postgresql+psycopg://app:PASSWORD@DB_HOST:5432/gobbi?sslmode=verify-full&sslrootcert=/run/certs/rds.pem
# GOOGLE_API_KEY is optional. Set both key and a currently available model to enable LLM.
LLM_MODEL=
GOOGLE_API_KEY=
# Required in production. Store this value in AWS Secrets Manager.
AGENT_API_KEY=
